{
  "name": "dsh-side-chat-plus",
  "version": "0.1.0",
  "description": "Dual-mode DSH side discussions: tool-free chat and safely scoped research Agents.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {"build": "node scripts/build.mjs", "test:core": "node --test test/*.test.mjs", "test:client": "esbuild test/client.test.jsx --bundle --platform=node --format=esm --packages=external --loader:.css=text --outfile=test/.client.test.generated.mjs && node --test test/.client.test.generated.mjs", "test": "npm run test:core && npm run test:client", "check": "npm test && npm run build", "prepack": "npm run build"},
  "engines": {"node": ">=24", "dsh": ">=0.2.2-rc.1 <0.2.3-0"},
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1"
  },
  "devDependencies": {"esbuild": "0.25.0", "react": "18.3.1", "react-dom": "18.3.1", "jsdom": "^26.1.0"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "engines": {"dsh": ">=0.2.2-rc.1 <0.2.3-0"}, "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar-right"]}},
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/SiyuQian/dsh-side-chat-plus.git"},
  "homepage": "https://github.com/SiyuQian/dsh-side-chat-plus#readme",
  "bugs": {"url": "https://github.com/SiyuQian/dsh-side-chat-plus/issues"},
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "side-chat", "agent"]
}
